workDir = "/fs/scratch/PCON0160/00AA_AF3"

singularity.cacheDir = "${baseDir}/singularity"

process.shell = ['/bin/bash', '-euo', 'pipefail']
// Global default params, used in configs

params {

    base = baseDir
    msa_cache = "/fs/scratch/PCON0160/00AA_AF3_msa_cache_dir"
    inference_models = "/fs/scratch/PCON0160/00AA_AF3_inference_models"
    align_batch          = 120   // JSONs per batched job
    align_parallel       = 4     // how many run in parallel inside the job
    align_cpus_per_task  = 28    // cores per srun step
    msa_cache            = "/fs/scratch/PCON0160/00AA_AF3_msa_cache_dir"

}

process {

    withLabel:'af3_alignment'{
        executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        clusterOptions = "--account=PCON0160 --ntasks=1 --cpus-per-task=28 --partition=nextgen --cluster=ascend "
        errorStrategy = 'ignore' 
    }

    withLabel: 'af3_inference' {
        executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        clusterOptions = "--account=PCON0160 --ntasks=1 --gpus-per-node=1 --cpus-per-task=4 --mem=100G --time=01:00:00 --partition=nextgen --cluster=ascend "
        errorStrategy = 'ignore'   // Always ignore after maxRetries is exceeded
    }

    withLabel:'base'{
        executor = 'local'
        singularity.enabled = false
        singularity.autoMounts = false
        clusterOptions = "--account=PCON0160 --time=03:00:00 --ntasks=1 --cpus-per-task=8 --mem=64G --partition=nextgen --cluster=ascend "
        container = null
    }

    withLabel: 'af3_alignment_batch_srun' {
        executor = 'slurm'
        clusterOptions = "--account=PCON0160 --ntasks=1 --cpus-per-task=28 --time=12:00:00 --cpus=120 --partition=nextgen --cluster=ascend --exclusive "
        executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
    }
    

}